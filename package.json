{
  "name": "nextjs-osm",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "./src/database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "pnpm dlx prisma generate",
    "migrate": "pnpm dlx prisma migrate dev --create-only",
    "deploy": "pnpm dlx prisma migrate deploy",
    "deploy:prod": "dotenv -e .env.prod.local -- pnpm dlx prisma migrate deploy",
    "studio": "pnpm dlx prisma studio",
    "studio:prod": "dotenv -e .env.prod.local -- pnpm dlx prisma studio",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,html,css,json}": [
      "pnpm prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "next": "14.0.0",
    "nextjs-osm": "link:",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "commitizen": "^4.3.0",
    "dotenv": "^16.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}
